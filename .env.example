# Port exposed on the host
JSON_PORT=5000

# Serial device for the USB-to-RS232 adapter connected to the nobreak
DEVICE_PATH=/dev/ttyUSB0
BAUD_RATE=2400

# How often (seconds) the nobreak is polled
POLL_INTERVAL=15

# Web UI login (see README "Web UI"). Leave blank to disable login
# entirely - fine on a trusted LAN, open to anyone who can reach the port
# otherwise. Sessions last JWT_EXPIRY_HOURS; JWT_SECRET can be pinned so
# they survive a container restart (otherwise a random one is generated
# each time, which just means logging in again).
WEB_PASSWORD=
JWT_SECRET=
JWT_EXPIRY_HOURS=24

# Home Assistant MQTT auto-discovery - leave MQTT_HOST blank to disable and
# use the /monitor JSON endpoint (see homeassistant/configuration.yaml.example)
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_BASE_TOPIC=sms_powerview
DEVICE_NAME=SMS Nobreak
DEVICE_ID=sms_powerview_ups
